# ═══════════════════════════════════════════════════════════
# BARAMASI — environment values (placeholders only).
#
# This project is a STATIC site (HTML/CSS/JS, no build step),
# so the two PUBLIC Supabase values are actually read from
# js/config.js — fill them in there. The values below are the
# canonical names you would set in Vercel *if* you ever add a
# build step / server, mapped to the current static setup:
#
#   NEXT_PUBLIC_SUPABASE_URL             → js/config.js  SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY → js/config.js  SUPABASE_PUBLISHABLE_KEY
#   (legacy alias: NEXT_PUBLIC_SUPABASE_ANON_KEY)
#
#   SUPABASE_SECRET_KEY  (or legacy SUPABASE_SERVICE_ROLE_KEY)
#     → NOT used by the static site. Writes are protected by
#       Supabase Row Level Security instead. Only needed for
#       tools/seed.mjs.
#
#   ADMIN_PASSWORD → the admin user's Supabase Auth password
#       (email + password login on /admin). There is no
#       server-side cookie in this static project.
# ═══════════════════════════════════════════════════════════

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY   # sb_publishable_… or anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY                 # legacy alias of the above
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY                                  # seed script only — never in the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY                      # legacy alias of the above
ADMIN_PASSWORD=                                                     # admin login password (Supabase Auth)
